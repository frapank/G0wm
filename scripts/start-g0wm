#!/bin/sh
set -eu

audio_procs='pipewire|pipewire-pulse|wireplumber'

guard() {
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        echo "start-g0wm: already inside a Wayland session ($WAYLAND_DISPLAY), refusing to nest" >&2
        exit 1
    fi

    if ! command -v g0wm >/dev/null 2>&1; then
        echo "start-g0wm: g0wm not found in PATH, cannot start" >&2
        exit 1
    fi

    # a second session kills the audio and bar of the first
    if pgrep -u "$(id -u)" -x g0wm >/dev/null 2>&1; then
        echo "start-g0wm: g0wm is already running for this user, refusing to start another" >&2
        exit 1
    fi
    if command -v flock >/dev/null 2>&1 && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
        exec 9>"$XDG_RUNTIME_DIR/start-g0wm.lock"
        if ! flock -n 9; then
            echo "start-g0wm: another start-g0wm is running, refusing to start" >&2
            exit 1
        fi
    fi
}

export_env() {
    export XDG_CURRENT_DESKTOP=g0wm
    export XDG_SESSION_TYPE=wayland
    export XDG_SESSION_DESKTOP=g0wm

    export MOZ_ENABLE_WAYLAND=1
    export QT_QPA_PLATFORM=wayland
    export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
    export SDL_VIDEODRIVER=wayland
    export _JAVA_AWT_WM_NONREPARENTING=1

    export GDK_BACKEND=wayland,x11
    export CLUTTER_BACKEND=wayland
}

setup_log() {
    log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/g0wm"
    mkdir -p "$log_dir"

    cd "$HOME"

    # ulimit -c is a bashism, guarded with `|| true`.
    # shellcheck disable=SC3045
    ulimit -c unlimited 2>/dev/null || true
}

stop_audio() {
    [ "${G0WM_AUDIO:-1}" != 0 ] || return 0
    pkill -u "$(id -u)" -x "$audio_procs" 2>/dev/null || true

    i=0
    while pgrep -u "$(id -u)" -x "$audio_procs" >/dev/null 2>&1; do
        i=$((i + 1))
        if [ "$i" -ge 30 ]; then
            pkill -KILL -u "$(id -u)" -x "$audio_procs" 2>/dev/null || true
            sleep 0.5
            break
        fi
        sleep 0.1
    done
}

cleanup() {
    stop_audio
    pkill -u "$(id -u)" -x 'g0wm-status.sh|swaybg|swayidle' 2>/dev/null || true

    for core in "$HOME"/core "$HOME"/core.*; do
        [ -f "$core" ] || continue
        mv "$core" "$log_dir/$(basename "$core").$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
    done
}

start_audio() { # builds audio_cmd, run before g0wm in the inner shell
    audio_cmd=
    if [ "${G0WM_AUDIO:-1}" = 0 ]; then
        return 0
    elif command -v pipewire >/dev/null 2>&1; then
        audio_cmd='pipewire >/dev/null 2>&1 &
n=0
while [ ! -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pipewire-0" ] && [ "$n" -lt 50 ]; do
    sleep 0.1
    n=$((n + 1))
done
'
        if command -v wireplumber >/dev/null 2>&1; then
            audio_cmd="${audio_cmd}sleep 1
pgrep -u \"\$(id -u)\" -x wireplumber >/dev/null 2>&1 || wireplumber >/dev/null 2>&1 &
"
        else
            echo "start-g0wm: wireplumber not found, no session/policy management for audio" >&2
        fi

        if command -v pipewire-pulse >/dev/null 2>&1; then
            audio_cmd="${audio_cmd}[ -S \"\${XDG_RUNTIME_DIR:-/run/user/\$(id -u)}/pulse/native\" ] || pipewire-pulse >/dev/null 2>&1 &"
        else
            echo "start-g0wm: pipewire-pulse not found, PulseAudio clients will have no server" >&2
        fi
    else
        echo "start-g0wm: pipewire not found, starting without an audio server" >&2
    fi
}

# restart the status script while g0wm runs
# 141 means g0wm closed the pipe
status_loop() {
    while :; do
        rc=0
        g0wm-status.sh || rc=$?
        [ "$rc" -ne 141 ] || return 0
        sleep 1
        pgrep -u "$(id -u)" -x g0wm >/dev/null 2>&1 || return 0
    done
}

run_session() {
    inner_cmd="${audio_cmd}exec g0wm"

    session_launcher=
    if command -v dbus-run-session >/dev/null 2>&1 && command -v dbus-daemon >/dev/null 2>&1; then
        session_launcher="dbus-run-session --"
    else
        echo "start-g0wm: dbus-run-session/dbus-daemon not found, running without a private D-Bus session (systray will be unavailable)" >&2
    fi

    if command -v g0wm-status.sh >/dev/null 2>&1; then
        status_loop 9>&- | $session_launcher sh -c "$inner_cmd" 9>&- >>"$log_dir/g0wm.log" 2>&1
    else
        echo "start-g0wm: g0wm-status.sh not found, starting without bar status text" >&2
        $session_launcher sh -c "$inner_cmd" 9>&- >>"$log_dir/g0wm.log" 2>&1
    fi
}

main() {
    guard
    export_env
    setup_log

    stop_audio

    trap cleanup EXIT
    trap 'exit 143' HUP INT TERM

    start_audio
    run_session
}

main "$@"
