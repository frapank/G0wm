#!/bin/sh
set -eu

audio_procs='pipewire|pipewire-pulse|wireplumber'

guard() {
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        echo "start-g0wn: already inside a Wayland session ($WAYLAND_DISPLAY), refusing to nest" >&2
        exit 1
    fi

    if ! command -v g0wn >/dev/null 2>&1; then
        echo "start-g0wn: g0wn not found in PATH, cannot start" >&2
        exit 1
    fi
}

export_env() {
    export XDG_CURRENT_DESKTOP=g0wn
    export XDG_SESSION_TYPE=wayland
    export XDG_SESSION_DESKTOP=g0wn

    export MOZ_ENABLE_WAYLAND=1
    export QT_QPA_PLATFORM=wayland
    export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
    export SDL_VIDEODRIVER=wayland
    export _JAVA_AWT_WM_NONREPARENTING=1

    export GDK_BACKEND=wayland,x11
    export CLUTTER_BACKEND=wayland
}

setup_log() {
    log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/g0wn"
    mkdir -p "$log_dir"

    cd "$HOME"

    # ulimit -c is a bashism, guarded with `|| true`.
    # shellcheck disable=SC3045
    ulimit -c unlimited 2>/dev/null || true
}

stop_audio() {
    pkill -u "$(id -u)" -x "$audio_procs" 2>/dev/null || true

    i=0
    while pgrep -u "$(id -u)" -x "$audio_procs" >/dev/null 2>&1; do
        i=$((i + 1))
        if [ "$i" -ge 30 ]; then
            pkill -KILL -u "$(id -u)" -x "$audio_procs" 2>/dev/null || true
            sleep 0.5
            break
        fi
        sleep 0.1
    done
}

cleanup() {
    stop_audio
    pkill -u "$(id -u)" -x 'g0wn-status.sh|swaybg|swayidle' 2>/dev/null || true

    for core in "$HOME"/core "$HOME"/core.*; do
        [ -f "$core" ] || continue
        mv "$core" "$log_dir/$(basename "$core").$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
    done
}

start_audio() { # builds audio_cmd, run before g0wn in the inner shell
    audio_cmd=
    if command -v pipewire >/dev/null 2>&1; then
        audio_cmd='pipewire >/dev/null 2>&1 &
n=0
while [ ! -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pipewire-0" ] && [ "$n" -lt 50 ]; do
    sleep 0.1
    n=$((n + 1))
done
'
        if command -v wireplumber >/dev/null 2>&1; then
            audio_cmd="${audio_cmd}sleep 1
pgrep -u \"\$(id -u)\" -x wireplumber >/dev/null 2>&1 || wireplumber >/dev/null 2>&1 &
"
        else
            echo "start-g0wn: wireplumber not found, no session/policy management for audio" >&2
        fi

        if command -v pipewire-pulse >/dev/null 2>&1; then
            audio_cmd="${audio_cmd}[ -S \"\${XDG_RUNTIME_DIR:-/run/user/\$(id -u)}/pulse/native\" ] || pipewire-pulse >/dev/null 2>&1 &"
        else
            echo "start-g0wn: pipewire-pulse not found, PulseAudio clients will have no server" >&2
        fi
    else
        echo "start-g0wn: pipewire not found, starting without an audio server" >&2
    fi
}

run_session() {
    inner_cmd="${audio_cmd}exec g0wn"

    session_launcher=
    if command -v dbus-run-session >/dev/null 2>&1 && command -v dbus-daemon >/dev/null 2>&1; then
        session_launcher="dbus-run-session --"
    else
        echo "start-g0wn: dbus-run-session/dbus-daemon not found, running without a private D-Bus session (systray will be unavailable)" >&2
    fi

    if command -v g0wn-status.sh >/dev/null 2>&1; then
        g0wn-status.sh | $session_launcher sh -c "$inner_cmd" >>"$log_dir/g0wn.log" 2>&1
    else
        echo "start-g0wn: g0wn-status.sh not found, starting without bar status text" >&2
        $session_launcher sh -c "$inner_cmd" >>"$log_dir/g0wn.log" 2>&1
    fi
}

main() {
    guard
    export_env
    setup_log

    stop_audio

    trap cleanup EXIT
    trap 'exit 143' HUP INT TERM

    start_audio
    run_session
}

main "$@"
