#!/bin/sh
# Interactive generator for status.conf, the config of scripts/g0wn-status.sh,
# driven by the defaults that script falls back to on its own.
# Plain POSIX shell: runs on Linux, the BSDs and anything else with a /bin/sh.
set -u

options() { # "$@" -> out, edit set from the command line; -h exits on its own
	while [ $# -gt 0 ]; do
		case $1 in
		-o|--output)
			shift; [ $# -gt 0 ] || { echo "status_gen: -o needs a file" >&2; exit 1; }
			out=$1 ;;
		-c|--current)
			edit=1 ;;
		-h|--help)
			cat <<EOF
Usage: ./status_gen [-c] [-o FILE]

Walks through the bar status settings and writes
\${XDG_CONFIG_HOME:-\$HOME/.config}/g0wn/status.conf, which scripts/g0wn-status.sh
reads. Every default is g0wn-status.sh's own, so pressing Enter at each prompt
keeps the clock and battery it shows without a config file.

  -c, --current   edit the existing status.conf instead: it becomes the source
                  of every default
  -o, --output    write somewhere else than the default path
EOF
			exit 0 ;;
		*) echo "status_gen: unknown option '$1'" >&2; exit 1 ;;
		esac
		shift
	done
}

workspace() { # validates the paths, then scratch dir, cleanup trap and fds
	[ -n "$edit" ] && def=$out
	[ -z "$def" ] || [ -f "$def" ] || die "$def not found"
	case $out in */*) mkdir -p "${out%/*}" || die "cannot create ${out%/*}" ;; esac
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/status_gen.XXXXXX") || exit 1
	trap 'rm -rf "$tmp"' EXIT
	trap 'rm -rf "$tmp"; exit 130' HUP INT TERM
	vals=$tmp/vals
	all_modules='date time battery cpu ram netdown netup'
	all_colors='color_date color_time color_battery color_cpu color_ram
color_netdown color_netup color_battery_low color_battery_charging'
	use_icons=0
	ip= # '%i ' once icons are on
	sel= # picked modules, in order
	nl=$(printf '\n_'); nl=${nl%_}
	: >"$vals"
	exec 3<&0 # answers always come from here, loops are free to redirect stdin
}

interface() { # B D A R, dash, colour depth and terminal width
	B= D= A= R= sg= dash=- depth=0 utf8=0
	if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
		depth=8
		case ${TERM:-} in *256color*) depth=256 ;; *direct*) depth=24 ;; esac
		case ${COLORTERM:-} in truecolor|24bit) depth=24 ;; esac
		B=$(printf '\033[1m') D=$(printf '\033[2m') R=$(printf '\033[0m')
		sgr 124 58 237 93 35; A=$sg
	fi
	case ${LC_ALL:-${LC_CTYPE:-${LANG:-C}}} in
	*[Uu][Tt][Ff]*) dash=$(printf '\342\224\200') utf8=1 ;;
	esac
	cols=$(tput cols 2>/dev/null) || cols=80
	case $cols in ''|*[!0-9]*|0) cols=80 ;; esac
}

sgr() { # r g b, 256 index, 8 code -> sg
	case $depth in
	24) sg=$(printf '\033[38;2;%d;%d;%dm' "$1" "$2" "$3") ;;
	256) sg=$(printf '\033[38;5;%dm' "$4") ;;
	8) sg=$(printf '\033[%sm' "$5") ;;
	*) sg= ;;
	esac
}

# f full block, u upper half, l lower half, so this file stays ASCII
banner() { # subtitle
	bn_f=$(printf '\342\226\210') bn_u=$(printf '\342\226\200')
	bn_l=$(printf '\342\226\204')
	[ "$utf8" = 1 ] || { bn_f='#' bn_u='"' bn_l=','; }
	[ "$cols" -ge 36 ] || { printf '%sg0wm%s %s\n' "$B" "$R" "$1"; return; }
	bn_i=0
	for bn_row in '.l...llll...lll' '.uffffffu.lffuuu' \
		'...ff...l.ff.lufl|...........l' \
		'...ff..ff.ff...ff|.ufl.fl.ffuffflfffl' \
		'...ff..ff.ff..lff|..fflfflff.ff.ff.ff' \
		'...ufffff..ufffu.|...uffuffulff.ff.uf' \
		'...l...ff' '...uffffu'; do
		bn_i=$((bn_i + 1))
		case $bn_i in
		3) sgr 255 255 255 231 '1;37' ;;
		4) sgr 216 216 216 252 '0;37' ;;
		5) sgr 168 168 168 247 '0;37' ;;
		6) sgr 120 120 120 243 '1;30' ;;
		esac
		draw "${bn_row%%|*}"; printf '%s%s' "$A" "$dw"
		case $bn_row in
		*'|'*) draw "${bn_row#*|}"; printf '%s%s' "$sg" "$dw" ;;
		esac
		printf '%s\n' "$R"
	done
	printf '%s   %s%s\n' "$D" "$1" "$R"
}

draw() { # tokens -> dw
	dw= dw_r=$1
	while [ -n "$dw_r" ]; do
		case $dw_r in
		f*) dw=$dw$bn_f ;; u*) dw=$dw$bn_u ;; l*) dw=$dw$bn_l ;; *) dw="$dw " ;;
		esac
		dw_r=${dw_r#?}
	done
}

rule() {
	rl_w=58 rl_s= rl_i=0
	[ "$cols" -lt "$rl_w" ] && rl_w=$cols
	while [ $rl_i -lt $rl_w ]; do rl_s=$rl_s$dash rl_i=$((rl_i + 1)); done
	printf '%s%s%s\n' "$D" "$rl_s" "$R"
}
title() { printf '\n%s%s%s\n' "$B" "$1" "$R"; rule; }
note() { printf '%s%s%s\n' "$D" "$1" "$R"; }
die() { printf 'status_gen: %s\n' "$*" >&2; exit 1; }

ask() { # prompt default -> ans
	if [ -n "$2" ]; then
		printf '%s %s[%s]%s ' "$1" "$A" "$2" "$R"
	else
		printf '%s ' "$1"
	fi
	IFS= read -r ans <&3 || { printf '\n'; die 'aborted'; }
	[ -n "$ans" ] || ans=$2
}

askyn() { # prompt default(y|n); true when yes
	while :; do
		ask "$1 (y/n)" "$2"
		case $ans in [Yy]*) return 0 ;; [Nn]*) return 1 ;; esac
		note 'answer y or n'
	done
}

asknum() { # prompt default -> ans
	while :; do
		ask "$1" "$2"
		case $ans in ''|*[!0-9]*) note 'enter a whole number' ;; *) return ;; esac
	done
}

askcolor() { # setting prompt default
	ac_var=$1
	while :; do
		ask "$2" "${3:-none}"
		case $ans in none|None|NONE|off) ans= ;; esac
		[ -z "$ans" ] && break
		is_color "$ans" && break
		note '  #RRGGBB or #RRGGBBAA, or none for the bar foreground'
	done
	setval "$ac_var" "$ans"
	if [ -n "$ans" ]; then
		swatch "$ans"
		printf '  %sthe module is drawn in this colour%s\n' "$sw_s" "$R"
	fi
}

menu() { # prompt default-index item... -> choice
	mn_prompt=$1 mn_def=$2 mn_i=1
	shift 2
	for mn_it in "$@"; do
		printf '  %s%d%s) %s\n' "$A" "$mn_i" "$R" "$mn_it"
		mn_i=$((mn_i + 1))
	done
	while :; do
		ask "$mn_prompt" "$mn_def"
		case $ans in
		''|*[!0-9]*|??????*) ;;
		*) [ "$ans" -ge 1 ] && [ "$ans" -lt "$mn_i" ] && { choice=$ans; return; } ;;
		esac
		note "enter 1-$((mn_i - 1))"
	done
}

setval() { printf '%s\t%s\n' "$1" "$2" >>"$vals"; }

dflt() { # built-in default of a setting, as g0wn-status.sh has it
	case $1 in
	modules) echo 'date time battery' ;;
	interval) echo 1 ;;
	battery_interval) echo 30 ;;
	prefix|separator|suffix) echo ' ' ;;
	battery_low) echo 20 ;;
	date_format) echo '%a %d %b' ;;
	time_format) echo '%H:%M:%S' ;;
	battery_format) echo '%v%' ;;
	cpu_format) echo 'cpu %v%' ;;
	ram_format) echo 'ram %v%' ;;
	netdown_format) echo 'down %v' ;;
	netup_format) echo 'up %v' ;;
	*) echo '' ;;
	esac
}

# gvfile marks a value read from the template, not one nobody ever set
getval() { # setting -> gv, gvfile
	gv= gvfile=0
	if [ -n "$def" ] && [ -f "$def" ]; then
		# a leading = marks a line present but empty
		gv=$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*/=/p" "$def" |
			sed -n '$p')
		case $gv in
		=*) gvfile=1 gv=${gv#=}
			gv=${gv%"${gv##*[! ]}"}
			case $gv in '"'*'"') gv=${gv#\"} gv=${gv%\"} ;; esac ;;
		esac
	fi
	[ "$gvfile" = 1 ] || gv=$(dflt "$1")
}

# octal escapes, so this file stays ASCII
icon_of() { # module -> ic, the default Nerd Font glyph
	case $1 in
	date) ic=$(printf '\357\201\263') ;;                  # U+F073 calendar
	time) ic=$(printf '\357\200\227') ;;                  # U+F017 clock
	battery) ic=$(printf '\357\211\204 \357\211\203 \357\211\202 \357\211\201 \357\211\200') ;;
	cpu) ic=$(printf '\357\213\233') ;;                   # U+F2DB microchip
	ram) ic=$(printf '\357\224\270') ;;                   # U+F538 memory
	netdown) ic=$(printf '\357\201\243') ;;               # U+F063 arrow-down
	netup) ic=$(printf '\357\201\242') ;;                 # U+F062 arrow-up
	*) ic= ;;
	esac
}

icon_for() { # module -> ic, empty when icons are off
	ic=
	[ "$use_icons" = 1 ] || return 0
	getval "icon_$1"
	if [ -n "$gv" ]; then ic=$gv; else icon_of "$1"; fi
}

color_dflt() { # setting -> cd
	case $1 in
	color_date) cd='#928374' ;;
	color_time) cd='#ebdbb2' ;;
	color_battery) cd='#8ec07c' ;;
	color_cpu) cd='#83a598' ;;
	color_ram) cd='#d3869b' ;;
	color_netdown) cd='#b8bb26' ;;
	color_netup) cd='#fabd2f' ;;
	color_battery_low) cd='#fb4934' ;;
	color_battery_charging) cd='#fabd2f' ;;
	*) cd= ;;
	esac
}

is_color() { # true when the value is #RRGGBB or #RRGGBBAA
	case $1 in
	'#'[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]\
[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) return 0 ;;
	'#'[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]\
[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) return 0 ;;
	esac
	return 1
}

hexval() { # one hex digit -> hv
	case $1 in
	[0-9]) hv=$1 ;;
	a|A) hv=10 ;; b|B) hv=11 ;; c|C) hv=12 ;;
	d|D) hv=13 ;; e|E) hv=14 ;; f|F) hv=15 ;;
	*) hv=0 ;;
	esac
}

byte() { # two hex digits -> bt
	hexval "${1%?}"; bt=$((hv * 16))
	hexval "${1#?}"; bt=$((bt + hv))
}

swatch() { # #RRGGBB[AA] -> sw_s, the escape that paints the terminal with it
	sw_s=
	[ "$depth" = 0 ] && return 0 # this terminal is not taking colours
	sw_h=${1#\#}
	case $sw_h in ????????) sw_h=${sw_h%??} ;; esac # ANSI has no alpha
	byte "${sw_h%????}"; sw_r=$bt
	sw_h=${sw_h#??}
	byte "${sw_h%??}"; sw_g=$bt
	byte "${sw_h#??}"; sw_b=$bt
	# without true rgb the swatch takes the nearest colour the terminal has
	sw_i=$((16 + 36 * (sw_r * 5 / 255) + 6 * (sw_g * 5 / 255) + sw_b * 5 / 255))
	sw_8=$((30 + (sw_r > 127) + 2 * (sw_g > 127) + 4 * (sw_b > 127)))
	sgr "$sw_r" "$sw_g" "$sw_b" "$sw_i" "0;$sw_8"; sw_s=$sg
}

subst() { # string token replacement -> sb (same rule g0wn-status.sh applies)
	sb= sb_rest=$1
	while :; do
		case $sb_rest in
		*"$2"*) sb=$sb${sb_rest%%"$2"*}$3; sb_rest=${sb_rest#*"$2"} ;;
		*) sb=$sb$sb_rest; return ;;
		esac
	done
}

render_tpl() { # template module -> rt, as g0wn-status.sh would fill it in
	rt_ic=
	case $2 in
	battery) rt_v=87 ;;
	cpu) rt_v=13 ;;
	ram) rt_v=42 ;;
	netdown|netup) rt_v=1.2M ;;
	*) rt_v= ;;
	esac
	if [ "$use_icons" = 1 ]; then
		icon_for "$2"; rt_ic=$ic
		# the battery icon is a list, the sample takes the full one
		[ "$2" = battery ] && for rt_g in $rt_ic; do rt_ic=$rt_g; done
	fi
	case $2 in
	date|time)
		subst "$1" '%i' "$rt_ic"
		rt=$(date "+$sb" 2>/dev/null) || rt='(bad format)'
		subst "$rt" "$nl" ' '; rt=$sb # a %n would break the menu below
		;;
	*)
		subst "$1" '%v' "$rt_v"; rt=$sb
		subst "$rt" '%i' "$rt_ic"; rt=$sb
		subst "$rt" '%u' 6.1G; rt=$sb
		subst "$rt" '%t' 15.5G; rt=$sb
		;;
	esac
}

askfmt() { # setting module prompt hint preset...
	af_var=$1 af_mod=$2 af_prompt=$3 af_hint=$4
	shift 4
	getval "$af_var"; af_cur=$gv
	# with icons on, a format nobody set yet gives way to the icon preset
	if [ -z "$af_cur" ] || { [ "$gvfile" = 0 ] && [ "$use_icons" = 1 ]; }; then
		af_cur=$1
	fi
	# a format that matches no preset goes first, so Enter keeps it
	af_keep=1
	for af_p in "$@"; do
		[ "$af_p" = "$af_cur" ] && af_keep=0
	done
	[ "$af_keep" = 1 ] && set -- "$af_cur" "$@"
	: >"$tmp/tpls"; : >"$tmp/items"
	af_i=1 af_def=0
	for af_p in "$@"; do
		printf '%s\n' "$af_p" >>"$tmp/tpls"
		render_tpl "$af_p" "$af_mod"
		printf '%s   %s(%s)%s\n' "$rt" "$D" "$af_p" "$R" >>"$tmp/items"
		[ "$af_p" = "$af_cur" ] && [ "$af_def" = 0 ] && af_def=$af_i
		af_i=$((af_i + 1))
	done
	[ "$af_def" = 0 ] && af_def=$af_i
	set -f; af_ifs=$IFS; IFS=$nl
	set -- $(cat "$tmp/items")
	IFS=$af_ifs; set +f
	menu "$af_prompt" "$af_def" "$@" 'something else'
	if [ "$choice" -lt "$af_i" ]; then
		setval "$af_var" "$(sed -n "${choice}p" "$tmp/tpls")"
		return
	fi
	note "$af_hint"
	while :; do
		ask "  $af_prompt" "$af_cur"
		af_cur=$ans # askyn below answers into ans, so keep it here
		render_tpl "$af_cur" "$af_mod"
		note "  shown as: $rt"
		askyn '  keep it' y && break
	done
	setval "$af_var" "$af_cur"
}

have() { # module -> true when this system can feed it
	case $1 in
	date|time) command -v date >/dev/null 2>&1 ;;
	battery)
		case $(uname -s 2>/dev/null) in
		Linux) set -- /sys/class/power_supply/BAT*; [ -d "$1" ] ;;
		FreeBSD) command -v sysctl >/dev/null 2>&1 ;;
		OpenBSD) command -v apm >/dev/null 2>&1 ;;
		*) false ;;
		esac ;;
	cpu) [ -r /proc/stat ] ||
		{ command -v sysctl >/dev/null 2>&1 &&
			[ -n "$(sysctl -n kern.cp_time 2>/dev/null)" ]; } ;;
	ram) [ -r /proc/meminfo ] ;;
	netdown|netup)
		set -- /sys/class/net/*/statistics/rx_bytes; [ -r "$1" ] ||
			{ command -v netstat >/dev/null 2>&1 &&
				netstat -ibn 2>/dev/null | awk 'NR == 1 {
					for (i = 1; i <= NF; i++) {
						if ($i == "Ibytes") ib = i
						if ($i == "Obytes") ob = i
					}
					exit !(ib && ob)
				}'; } ;;
	*) false ;;
	esac
}

describe() { # module -> ds
	case $1 in
	date) ds='the date, in any strftime format' ;;
	time) ds='the clock, in any strftime format' ;;
	battery) ds='charge of every battery' ;;
	cpu) ds='cpu usage since the last update' ;;
	ram) ds='memory in use' ;;
	netdown) ds='download rate' ;;
	netup) ds='upload rate' ;;
	*) ds= ;;
	esac
}

icons() {
	title 'Nerd Font icons'
	note 'icons replace the labels: cpu 13% becomes the chip glyph and 13%'
	if command -v fc-list >/dev/null 2>&1; then
		ic_found=$(fc-list : family 2>/dev/null | tr ',' '\n' |
			grep -i 'nerd font' | sed 's/^[[:space:]]*//' | sort -u | head -1)
		if [ -n "$ic_found" ]; then
			note "found $ic_found"
			askyn 'use Nerd Font icons' y && use_icons=1
		else
			note 'no Nerd Font installed, so the glyphs would draw as boxes'
			note 'install one (Symbols Nerd Font is enough) and run this again'
			askyn 'enable them anyway' n && use_icons=1
		fi
	else
		note 'fc-list not found, cannot tell whether a Nerd Font is installed'
		askyn 'enable Nerd Font icons anyway' n && use_icons=1
	fi
	if [ "$use_icons" = 1 ]; then
		ip='%i '
		note 'the bar font in config.h needs the glyphs, or fontconfig has'
		note 'to be able to fall back to the Nerd Font for them'
	fi
}

modules() {
	title 'Modules'
	for md_m in $all_modules; do
		describe "$md_m"
		if have "$md_m"; then
			printf '  %s%-8s%s %s%s%s\n' "$A" "$md_m" "$R" "$D" "$ds" "$R"
		else
			printf '  %s%-8s%s %s%s (not available on this system)%s\n' \
				"$A" "$md_m" "$R" "$D" "$ds" "$R"
		fi
	done
	note 'they are drawn left to right in the order you list them'
	getval modules
	while :; do
		ask 'modules, in order (none for an empty bar)' "$gv"
		case $ans in none) ans= ;; esac
		md_bad=
		for md_m in $ans; do
			case " $all_modules " in
			*" $md_m "*) ;;
			*) md_bad="$md_bad $md_m" ;;
			esac
		done
		[ -n "$md_bad" ] || break
		note "unknown module:$md_bad"
	done
	sel=$ans
	setval modules "$sel"
	for md_m in $sel; do
		have "$md_m" ||
			note "$md_m has no source here, it will be skipped at runtime"
	done
}

formats() {
	[ -n "$sel" ] || return 0
	title 'Formats'
	for fm_m in $sel; do
		printf '\n%s%s%s\n' "$B" "$fm_m" "$R"
		case $fm_m in
		date)
			askfmt date_format date '  date format' \
				'  a strftime format, see date(1); %i is the icon' \
				"$ip%a %d %b" "$ip%d/%m" "$ip%Y-%m-%d" "$ip%a %d %B" ;;
		time)
			askfmt time_format time '  time format' \
				'  a strftime format, see date(1); %i is the icon' \
				"$ip%H:%M:%S" "$ip%H:%M" "$ip%I:%M %p" ;;
		battery)
			askfmt battery_format battery '  battery format' \
				'  %v is the charge, %i the icon for its level' \
				"$ip%v%" "$ip%v" 'bat %v%' ;;
		cpu)
			askfmt cpu_format cpu '  cpu format' \
				'  %v is the usage in percent, %i the icon' \
				"$ip%v%" 'cpu %v%' ;;
		ram)
			askfmt ram_format ram '  ram format' \
				'  %v is the percent in use, %u what it is, %t the total, %i the icon' \
				"$ip%v%" "$ip%u" 'ram %v%' '%u/%t' ;;
		netdown)
			askfmt netdown_format netdown '  download format' \
				'  %v is the rate, %i the icon' \
				"$ip%v" 'down %v' '%v/s' ;;
		netup)
			askfmt netup_format netup '  upload format' \
				'  %v is the rate, %i the icon' \
				"$ip%v" 'up %v' '%v/s' ;;
		esac
	done
}

colors() {
	[ -n "$sel" ] || return 0
	title 'Colours'
	note 'the bar reads colour escapes in the status text, so every module can'
	note 'have one of its own; none leaves it in the bar foreground'
	note 'upstream dwl would draw the escapes as text, this fork paints them'
	cl_on=n
	for cl_k in $all_colors; do
		getval "$cl_k"; [ -n "$gv" ] && cl_on=y
	done
	if ! askyn 'colour the status text' "$cl_on"; then
		# an explicit no clears whatever the template had
		for cl_k in $all_colors; do setval "$cl_k" ''; done
		return 0
	fi
	for cl_m in $sel; do
		# a template value the bar would not parse is not worth suggesting
		getval "color_$cl_m"
		is_color "$gv" || { color_dflt "color_$cl_m"; gv=$cd; }
		askcolor "color_$cl_m" "  $cl_m" "$gv"
	done
	case " $sel " in
	*' battery '*)
		note 'the battery takes two colours more: one under a level you pick,'
		note 'one while it charges, which outranks the low one'
		getval battery_low
		asknum '  low below (percent)' "$gv"; setval battery_low "$ans"
		getval color_battery_low
		is_color "$gv" || { color_dflt color_battery_low; gv=$cd; }
		askcolor color_battery_low '  low' "$gv"
		getval color_battery_charging
		is_color "$gv" || { color_dflt color_battery_charging; gv=$cd; }
		askcolor color_battery_charging '  charging' "$gv" ;;
	esac
}

network() {
	case " $sel " in *' netdown '*|*' netup '*) ;; *) return 0 ;; esac
	title 'Network'
	getval net_interface
	ask 'interfaces to count, space separated (all but loopback)' "${gv:-all}"
	case $ans in all) ans= ;; esac
	setval net_interface "$ans"
}

glyphs() {
	[ "$use_icons" = 1 ] || return 0
	[ -n "$sel" ] || return 0
	title 'Glyphs'
	note 'paste another character to change one'
	for gl_m in $sel; do
		icon_for "$gl_m"
		case $gl_m in
		battery) ask '  battery, from empty to full' "$ic" ;;
		*) ask "  $gl_m" "$ic" ;;
		esac
		setval "icon_$gl_m" "$ans"
	done
}

timing() {
	title 'Timing'
	if [ "$mode" = advanced ]; then
		getval interval
		asknum 'seconds between updates' "$gv"; setval interval "$ans"
	fi
	case " $sel " in
	*' battery '*)
		note 'a battery moves slowly and reading it is not free, so it has an'
		note 'interval of its own'
		getval battery_interval
		asknum 'seconds between battery reads' "$gv"
		setval battery_interval "$ans" ;;
	esac
}

layout() {
	title 'Layout'
	note 'the spaces you type are kept: they are what holds the status text'
	note 'apart from the systray and the edge of the bar'
	getval separator; ask 'between two modules' "$gv"; setval separator "$ans"
	getval prefix; ask 'before the first one' "$gv"; setval prefix "$ans"
	getval suffix; ask 'after the last one' "$gv"; setval suffix "$ans"
}

final() { # setting -> the value that was collected, or the current default
	# what decides is whether it was asked, not whether it has a value
	if fn=$(awk -v k="$1" '
		{ t = index($0, "\t")
		  if (t && substr($0, 1, t - 1) == k) { v = substr($0, t + 1); f = 1 } }
		END { if (!f) exit 1; print v }' "$vals"); then
		printf '%s' "$fn"
	else
		# a shown module gets its glyph, the others keep the old one
		case $1 in
		icon_*)
			if [ "$use_icons" = 1 ]; then
				case " $sel " in
				*" ${1#icon_} "*)
					icon_for "${1#icon_}"; printf '%s' "$ic"; return 0 ;;
				esac
			fi ;;
		esac
		getval "$1"; printf '%s' "$gv"
	fi
}

generate() { # the config file, every value quoted so spaces survive
	printf '# Status text of g0wn'\''s bar, read by g0wn-status.sh.\n'
	printf '# Written by ./status_gen on %s.\n' "$(date '+%Y-%m-%d %H:%M')"
	printf '# Quotes keep the spaces. In a format %%v is the value and %%i the\n'
	printf '# icon; ram has %%u and %%t too, date and time are strftime formats.\n'
	printf '# A colour is #RRGGBB or #RRGGBBAA, empty for the bar foreground.\n\n'
	printf 'modules = "%s"\n\n' "$(final modules)"
	printf 'interval = "%s"\n' "$(final interval)"
	printf 'battery_interval = "%s"\n\n' "$(final battery_interval)"
	printf 'prefix = "%s"\n' "$(final prefix)"
	printf 'separator = "%s"\n' "$(final separator)"
	printf 'suffix = "%s"\n\n' "$(final suffix)"
	for gn_m in $all_modules; do
		printf '%s_format = "%s"\n' "$gn_m" "$(final "${gn_m}_format")"
	done
	printf '\nnet_interface = "%s"\n\n' "$(final net_interface)"
	for gn_m in $all_modules; do
		printf 'icon_%s = "%s"\n' "$gn_m" "$(final "icon_$gn_m")"
	done
	printf '\n'
	for gn_m in $all_modules; do
		printf 'color_%s = "%s"\n' "$gn_m" "$(final "color_$gn_m")"
	done
	printf '\nbattery_low = "%s"\n' "$(final battery_low)"
	printf 'color_battery_low = "%s"\n' "$(final color_battery_low)"
	printf 'color_battery_charging = "%s"\n' "$(final color_battery_charging)"
}

# the bar's own parser, in awk: a preview that printed the escapes instead of
# the colours they stand for would be worth nothing
ansify() {
	[ "$depth" = 0 ] && { cat; return; }
	awk '
	function val(s,   i, v) {
		v = 0
		for (i = 1; i <= length(s); i++)
			v = v * 16 + index("0123456789abcdef",
				tolower(substr(s, i, 1))) - 1
		return v
	}
	function rgb(h) {
		return val(substr(h, 1, 2)) ";" val(substr(h, 3, 2)) ";" \
			val(substr(h, 5, 2))
	}
	BEGIN { ESC = sprintf("%c", 27) }
	{
		out = ""; rest = $0
		while (match(rest, /\^(\^|d\^|[cb]#[0-9a-fA-F]*\^)/)) {
			out = out substr(rest, 1, RSTART - 1)
			tok = substr(rest, RSTART, RLENGTH)
			rest = substr(rest, RSTART + RLENGTH)
			if (tok == "^^")
				out = out "^"
			else if (tok == "^d^")
				out = out ESC "[0m"
			else {
				h = substr(tok, 4, length(tok) - 4)
				if (length(h) == 6 || length(h) == 8)
					out = out ESC "[" \
						(substr(tok, 2, 1) == "c" ? "38" : "48") \
						";2;" rgb(h) "m"
				else
					out = out tok
			}
		}
		print out rest ESC "[0m"
	}'
}

preview() { # one line, drawn by g0wn-status.sh itself from the new file
	pv=$srcdir/scripts/g0wn-status.sh
	[ -x "$pv" ] || pv=$(command -v g0wn-status.sh 2>/dev/null)
	[ -n "$pv" ] && [ -x "$pv" ] || { note 'g0wn-status.sh not found, no preview'; return; }
	note 'one line, as the bar would draw it:'
	# a rate has to be sampled twice, so the script holds for one interval
	case " $sel " in
	*' cpu '*|*' netdown '*|*' netup '*) note 'one update away, hold on' ;;
	esac
	G0WN_STATUS_CONF=$1 "$pv" --once | ansify
}

main() {
	srcdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
	out=${G0WN_STATUS_CONF:-${XDG_CONFIG_HOME:-${HOME:-.}/.config}/g0wn/status.conf}
	def= # set once an existing file becomes the template
	mode=normal
	edit=

	options "$@"
	workspace
	interface

	banner 'status bar generator'

	keep=
	if [ -f "$out" ] && [ -z "$edit" ]; then
		title 'A status.conf is already there'
		menu 'what should happen to it' 4 'cancel' 'keep a backup, then generate' \
			'overwrite it' 'edit it: its own settings become the defaults'
		case $choice in
		1) note 'nothing written'; exit 0 ;;
		2) keep=$out.$(date +%Y%m%d-%H%M%S).bak ;;
		4) def=$out keep=$out.$(date +%Y%m%d-%H%M%S).bak ;;
		esac
	elif [ -n "$edit" ]; then
		keep=$out.$(date +%Y%m%d-%H%M%S).bak
	fi
	if [ -n "$def" ]; then
		note "defaults from ${def##*/}, writing ${out##*/}"
	else
		note "defaults from g0wn-status.sh, writing $out"
	fi

	title 'Mode'
	menu 'how much do you want to configure' 1 \
		'normal: modules and their format' \
		'advanced: also the glyphs, the spacing and the update interval'
	[ "$choice" = 2 ] && mode=advanced

	icons
	modules
	formats
	colors
	network
	[ "$mode" = advanced ] && glyphs
	timing
	[ "$mode" = advanced ] && layout

	generate >"$tmp/status.conf"
	grep -q '^modules' "$tmp/status.conf" || die 'generated file looks wrong, nothing written'
	if [ -n "$keep" ]; then
		cp "$out" "$keep" || die "cannot back up $out"
	fi
	cp "$tmp/status.conf" "$out" || die "cannot write $out"

	title 'Done'
	[ -n "$keep" ] && note "previous config kept as ${keep##*/}"
	printf 'wrote %s\n' "$out"
	preview "$out"
	note 'it is read when g0wn-status.sh starts, so log out and back in to apply it'
}

main "$@"
