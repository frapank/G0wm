%global debug_package %{nil}

Name:           g0wm
Version:        @VERSION@
Release:        1
Summary:        A personal Wayland desktop environment
License:        GPL-3.0-or-later AND MIT AND CC0-1.0 AND HPND-sell-variant
URL:            https://github.com/frapank/G0wm
BuildArch:      @ARCH@

# wlroots 0.20 minimums, as Fedora or openSUSE name them
Requires:       (libwayland-server >= 1.24.0 or libwayland-server0 >= 1.24.0)
Requires:       (libwayland-client >= 1.24.0 or libwayland-client0 >= 1.24.0)
Requires:       (libdrm >= 2.4.129 or libdrm2 >= 2.4.129)
Requires:       (libxkbcommon >= 1.8.0 or libxkbcommon0 >= 1.8.0)
Requires:       (pixman >= 0.46.0 or libpixman-1-0 >= 0.46.0)
Recommends:     /usr/bin/Xwayland

%description
g0wm is a dwl-based Wayland compositor with a bar, a system tray and
a tiling layout.

%install
cp -a @STAGE@/. %{buildroot}/

%files
/usr/bin/g0wm
/usr/share/man/man1/g0wm.1*
/usr/share/wayland-sessions/g0wm.desktop
%license /usr/share/licenses/g0wm
