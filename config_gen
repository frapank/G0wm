#!/bin/sh
# Interactive generator for config.h, driven by the defaults in config.def.h.
# Plain POSIX shell: runs on Linux, the BSDs and anything else with a /bin/sh.
set -u

options() { # "$@" -> out, edit set from the command line; -h exits on its own
	while [ $# -gt 0 ]; do
		case $1 in
		-o|--output)
			shift; [ $# -gt 0 ] || { echo "config_gen: -o needs a file" >&2; exit 1; }
			out=$1 ;;
		-c|--current)
			edit=1 ;;
		-h|--help)
			cat <<EOF
Usage: ./config_gen [-c] [-o FILE]

Walks through the dwl settings and writes config.h. Every default comes from
config.def.h, so pressing Enter at each prompt reproduces it.

  -c, --current   edit the existing config.h instead: it becomes both the
                  template and the source of every default
  -o, --output    write somewhere else than config.h
EOF
			exit 0 ;;
		*) echo "config_gen: unknown option '$1'" >&2; exit 1 ;;
		esac
		shift
	done
}

workspace() { # validates the template, then scratch dir, cleanup trap and fds
	[ -n "$edit" ] && def=$out
	[ -f "$def" ] || die "$def not found"
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/config_gen.XXXXXX") || exit 1
	trap 'rm -rf "$tmp"' EXIT
	trap 'rm -rf "$tmp"; exit 130' HUP INT TERM
	vals=$tmp/vals
	mons=$tmp/mons
	auto= # set once the autostart list has entries
	: >"$vals"
	exec 3<&0 # answers always come from here, loops are free to redirect stdin
}

interface() { # B D A R (bold/dim/accent/reset) and dash, used by rule()/title()
	B= D= A= R= dash=-
	if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
		B=$(printf '\033[1m') D=$(printf '\033[2m')
		A=$(printf '\033[36m') R=$(printf '\033[0m')
	fi
	case ${LC_ALL:-${LC_CTYPE:-${LANG:-C}}} in
	*[Uu][Tt][Ff]*) dash=$(printf '\342\224\200') ;;
	esac
}

rule() {
	rl_s= rl_i=0
	while [ $rl_i -lt 58 ]; do rl_s=$rl_s$dash rl_i=$((rl_i + 1)); done
	printf '%s%s%s\n' "$D" "$rl_s" "$R"
}
title() { printf '\n%s%s%s\n' "$B" "$1" "$R"; rule; }
note() { printf '%s%s%s\n' "$D" "$1" "$R"; }
die() { printf 'config_gen: %s\n' "$*" >&2; exit 1; }

ask() { # prompt default -> ans
	if [ -n "$2" ]; then
		printf '%s %s[%s]%s ' "$1" "$A" "$2" "$R"
	else
		printf '%s ' "$1"
	fi
	IFS= read -r ans <&3 || { printf '\n'; die 'aborted'; }
	[ -n "$ans" ] || ans=$2
}

askyn() { # prompt default(y|n); true when yes
	while :; do
		ask "$1 (y/n)" "$2"
		case $ans in [Yy]*) return 0 ;; [Nn]*) return 1 ;; esac
		note 'answer y or n'
	done
}

yn() { [ "$1" = 1 ] && echo y || echo n; } # default of a boolean setting

asknum() { # prompt default -> ans
	while :; do
		ask "$1" "$2"
		case $ans in ''|*[!0-9]*) note 'enter a whole number' ;; *) return ;; esac
	done
}

askfloat() { # prompt default -> ans
	while :; do
		ask "$1" "$2"
		case $ans in
		''|*[!0-9.]*|*.*.*) note 'enter a number like 0.55' ;;
		*) return ;;
		esac
	done
}

askpct() { # prompt default(0-100) -> ans as a float like 0.85f
	while :; do
		ask "$1" "$2"
		case $ans in
		''|*[!0-9]*) ;;
		*) if [ "$ans" -le 100 ]; then
			ans=$(awk -v p="$ans" 'BEGIN { printf "%.2ff", p / 100 }'); return
		fi ;;
		esac
		note 'enter a percentage, 0 to 100'
	done
}

askhex() { # prompt default -> ans as rrggbbaa
	while :; do
		ask "$1" "$2"
		ans=${ans#\#} ans=${ans#0x}
		case $ans in
		*[!0-9A-Fa-f]*) ;;
		??????) ans=${ans}ff; return ;;
		????????) return ;;
		esac
		note 'enter RRGGBB or RRGGBBAA'
	done
}

askkey() { # prompt default -> ans as an xkb key name
	while :; do
		ask "$1" "$2"
		case $ans in
		''|*[!A-Za-z0-9_]*) note 'enter a key name, e.g. q, Return, F1' ;;
		*) return ;;
		esac
	done
}

menu() { # prompt default-index item... -> choice
	mn_prompt=$1 mn_def=$2 mn_i=1
	shift 2
	for mn_it in "$@"; do
		printf '  %s%d%s) %s\n' "$A" "$mn_i" "$R" "$mn_it"
		mn_i=$((mn_i + 1))
	done
	while :; do
		ask "$mn_prompt" "$mn_def"
		case $ans in
		''|*[!0-9]*) ;;
		*) [ "$ans" -ge 1 ] && [ "$ans" -lt "$mn_i" ] && { choice=$ans; return; } ;;
		esac
		note "enter 1-$((mn_i - 1))"
	done
}

setval() { printf '%s\t%s\n' "$1" "$2" >>"$vals"; }

defval() { # initializer of a static variable in config.def.h
	awk -v want="$1" '
	/^static/ && index($0, "=") {
		eq = index($0, "="); lhs = substr($0, 1, eq - 1); name = lhs
		sub(/[ \t]*(\[\])?[ \t]*$/, "", name); sub(/^.*[^A-Za-z0-9_]/, "", name)
		if (name != want) next
		v = substr($0, eq + 1); sub(/;.*/, "", v)
		gsub(/^[ \t]+|[ \t]+$/, "", v); print v; exit
	}' "$def"
}

defbin() { defval "$1" | sed 's/[{}",]/ /g; s/^ *//; s/ .*//'; }

# float initializer as a percentage, 100 when the config predates the setting
defpct() {
	defval "$1" | awk '{ sub(/f$/, ""); p = $0 * 100 + 0.5 }
		END { printf "%d", p ? p : 100 }'
}

defcmd() { # command array as a command line, quoting the arguments that need it
	defval "$1" | awk '{
		n = split($0, p, /"/)
		for (i = 2; i <= n; i += 2)
			printf "%s%s", (i > 2 ? " " : ""), (p[i] ~ /[ \t]/ ? "\"" p[i] "\"" : p[i])
		print ""
	}'
}

defapps() { # quoted entries of a string array, which may span several lines
	awk -v want="$1" '
	!seen && index($0, want "[]") { seen = 1 }
	seen {
		s = $0; gsub(/\/\*.*\*\//, "", s); sub(/\/\/.*/, "", s)
		n = split(s, p, /"/)
		for (i = 2; i <= n; i += 2) printf "%s%s", (o++ ? " " : ""), p[i]
		if (index(s, ";")) exit
	}
	END { if (o) print "" }' "$def"
}

# Splits a command line into arguments the way a shell would: quoted runs stay
# together, so "wmenu -f 'monospace 10'" keeps the font as one argument.
split_cmd() {
	printf '%s\n' "$1" | awk '{
		tok = ""; q = ""; have = 0
		for (i = 1; i <= length($0); i++) {
			c = substr($0, i, 1)
			if (q != "") {
				if (c == q) q = ""; else { tok = tok c; have = 1 }
			} else if (c == "\"" || c == "'\''") {
				q = c; have = 1
			} else if (c == "\\") {
				tok = tok substr($0, ++i, 1); have = 1
			} else if (c == " " || c == "\t") {
				if (have) { print tok; tok = ""; have = 0 }
			} else { tok = tok c; have = 1 }
		}
		if (have) print tok
	}'
}

defscheme() { # scheme, column (1 fg, 2 bg, 3 border)
	awk -v s="[$1]" -v c="$2" '
	index($0, s) && index($0, "=") {
		n = split($0, f, /0x/)
		if (c + 1 <= n) { v = f[c + 1]; sub(/[^0-9a-fA-F].*/, "", v); print v }
		exit
	}' "$def"
}

defkey() { # key bound to an action or command
	awk -v t="$1" '$0 ~ ("[^A-Za-z0-9_]" t "[^A-Za-z0-9_]") && /XKB_KEY_/ {
		match($0, /XKB_KEY_[A-Za-z0-9_]+/)
		print substr($0, RSTART + 8, RLENGTH - 8); exit
	}' "$def"
}

# monrules[] uses designated initializers, so read the field by name
defmfact() {
	awk '/\.mfact[ \t]*=/ {
		sub(/.*\.mfact[ \t]*=[ \t]*/, ""); sub(/[ \t,f].*/, ""); print; exit
	}' "$def"
}

cargs() { # words -> "a", "b", with C escapes and ~ expanded (there is no shell)
	ca_out=
	for ca_w in "$@"; do
		case $ca_w in "~/"*) ca_w=$HOME/${ca_w#\~/} ;; esac
		ca_e=$(printf '%s' "$ca_w" | sed 's/[\\"]/\\&/g')
		ca_out=$ca_out'"'$ca_e'", '
	done
	printf '%s' "$ca_out"
}

carray() { printf '{ %sNULL }' "$(cargs "$@")"; }

askcmd() { # variable prompt default-command
	ac_var=$1
	ask "$2" "$3"
	set -f; ac_ifs=$IFS; IFS='
'
	set -- $(split_cmd "$ans")
	IFS=$ac_ifs; set +f
	[ $# -gt 0 ] || return 0
	# wmenu takes its theme on the command line, so keep it with the colors
	if [ $# -eq 1 ]; then
		case $1 in
		wmenu|wmenu-run)
			setval "$ac_var" "$(carray "$1" -f "$font_name $font_size" \
				-N "$c_normbg" -n "$c_normfg" -M "$c_selbg" -m "$c_selfg" \
				-S "$c_selbg" -s "$c_selfg")"
			return 0 ;;
		esac
	fi
	setval "$ac_var" "$(carray "$@")"
}

# Colors and fonts are also used to theme the launchers, so resolve them early.
theme_defaults() {
	font_name=$(defval fonts | sed 's/[{}"]//g; s/:.*//; s/^ *//; s/ *$//')
	font_size=$(defval fonts | sed 's/.*size=//; s/[^0-9].*//')
	[ -n "$font_size" ] || font_size=10
	c_normfg=$(defscheme SchemeNorm 1) c_normbg=$(defscheme SchemeNorm 2)
	c_selfg=$(defscheme SchemeSel 1) c_selbg=$(defscheme SchemeSel 3)
	c_urg=$(defscheme SchemeUrg 3) c_dimfg=$(defscheme SchemeTitle 1)
}

appearance() {
	title 'Appearance'
	if askyn 'gaps between windows' "$(yn "$(defval gaps)")"; then
		setval gaps 1
		asknum 'gap size in pixels' "$(defval gappx)"; setval gappx "$ans"
		askyn 'drop the outer gap with a single window' "$(yn "$(defval smartgaps)")" &&
			setval smartgaps 1 || setval smartgaps 0
	else
		setval gaps 0
	fi
	asknum 'window border in pixels' "$(defval borderpx)"; setval borderpx "$ans"
	askyn 'focus follows the mouse' "$(yn "$(defval sloppyfocus)")" &&
		setval sloppyfocus 1 || setval sloppyfocus 0
	asknum 'cursor size' "$(defval cursor_size)"; setval cursor_size "$ans"
	if grep -q '^static const char\* wallpaper' "$def"; then
		wp_def=$(defval wallpaper); wp_def=${wp_def#\"} wp_def=${wp_def%\"}
		ask 'wallpaper image path (empty for none)' "$wp_def"
		setval wallpaper "\"$ans\""
	fi
}

opacity() {
	title 'Window opacity'
	note '100% is fully opaque, which is the default and disables the feature'
	askpct 'opacity of the focused window' "$(defpct opacity_focus)"
	setval opacity_focus "$ans"
	askpct 'opacity of the unfocused windows' "$(defpct opacity_unfocus)"
	setval opacity_unfocus "$ans"

	note 'what dwl draws itself takes one value for the lot: the bar, with'
	note 'its systray and notifications, the title bars and the borders'
	askpct 'opacity of the bar, title bars and borders' "$(defpct opacity_deco)"
	setval opacity_deco "$ans"

	note 'the app list is matched against app ids, as the window rules are'
	menu 'the apps in the list are' \
		"$(($(defval opacity_exclusion_type) + 1))" \
		'the only ones with opacity' 'the only ones without it'
	setval opacity_exclusion_type "$([ "$choice" = 1 ] && echo 0 || echo 1)"
	ask 'apps, space separated (none means every app)' "$(defapps opacity_apps)"
	case $ans in none) ans= ;; esac
	set -f; op_ifs=$IFS; IFS='
'
	set -- $(split_cmd "$ans")
	IFS=$op_ifs; set +f
	setval opacity_apps "$(carray "$@")"

	note 'opacity can be turned off and on while dwl runs, with the key below'
	op_en=$(defval opacity_enabled)
	if askyn 'start with opacity on' "$(yn "${op_en:-1}")"; then
		setval opacity_enabled 1
	else
		setval opacity_enabled 0
	fi
	note 'xkb key names: q, Return, F1, space'
	askkey 'MOD + Alt + ? to turn opacity off and on' "$(defkey toggleopacity)"
	setval 'bind:toggleopacity' "XKB_KEY_$ans"
}

bar() {
	title 'Bar and systray'
	if askyn 'show the bar' "$(yn "$(defval showbar)")"; then
		setval showbar 1
		menu 'bar position' "$([ "$(defval topbar)" = 1 ] && echo 1 || echo 2)" top bottom
		setval topbar "$([ "$choice" = 1 ] && echo 1 || echo 0)"
		askyn 'show the focused window title' "$(yn "$(defval barwintitle)")" &&
			setval barwintitle 1 || setval barwintitle 0
		if askyn 'show the systray' "$(yn "$(defval showsystray)")"; then
			setval showsystray 1
			asknum 'systray icon size (0 fills the bar)' "$(defval systrayiconsize)"
			setval systrayiconsize "$ans"
		else
			setval showsystray 0
		fi
	else
		setval showbar 0
	fi
	askyn 'per-window title bars' "$(yn "$(defval titlebar)")" &&
		setval titlebar 1 || setval titlebar 0
	if askyn 'show notifications in the bar' "$(yn "$(defval shownotifications)")"; then
		setval shownotifications 1
		asknum 'seconds a notification stays up' "$(defval notification_timeout)"
		setval notification_timeout "$ans"
	else
		setval shownotifications 0
	fi
}

fontsel() {
	title 'Font'
	ask 'font family' "$font_name"; font_name=$ans
	asknum 'font size' "$font_size"; font_size=$ans
	setval fonts "{ \"$font_name:size=$font_size\" }"
}

colors() {
	title 'Colors'
	note 'hex RRGGBB or RRGGBBAA'
	if askyn 'set each scheme by hand instead of a palette' n; then
		for cl_s in SchemeNorm SchemeSel SchemeUrg SchemeTitle SchemeTitleSel SchemeNotify; do
			askhex "$cl_s foreground" "$(defscheme "$cl_s" 1)"; cl_fg=$ans
			askhex "$cl_s background" "$(defscheme "$cl_s" 2)"; cl_bg=$ans
			askhex "$cl_s border" "$(defscheme "$cl_s" 3)"; cl_bd=$ans
			setval "$cl_s" "{ 0x$cl_fg, 0x$cl_bg, 0x$cl_bd }"
			case $cl_s in
			SchemeNorm) c_normfg=$cl_fg c_normbg=$cl_bg ;;
			SchemeSel) c_selfg=$cl_fg c_selbg=$cl_bd ;;
			esac
		done
	else
		askhex 'background' "$c_normbg"; c_normbg=$ans
		askhex 'foreground' "$c_normfg"; c_normfg=$ans
		askhex 'inactive text' "$c_dimfg"; c_dimfg=$ans
		askhex 'accent (focused border and selection)' "$c_selbg"; c_selbg=$ans
		askhex 'urgent' "$c_urg"; c_urg=$ans
		c_selfg=$c_normfg
		setval SchemeNorm "{ 0x$c_normfg, 0x$c_normbg, 0x$c_normbg }"
		setval SchemeSel "{ 0x$c_selfg, 0x$c_normbg, 0x$c_selbg }"
		setval SchemeUrg "{ 0x$c_normfg, 0x$c_normbg, 0x$c_urg }"
		setval SchemeTitle "{ 0x$c_dimfg, 0x$c_normbg, 0x$c_normbg }"
		setval SchemeTitleSel "{ 0x$c_selfg, 0x$c_normbg, 0x$c_selbg }"
		setval SchemeNotify "{ 0x$c_normbg, 0x$c_normfg, 0x$c_normfg }"
	fi
	setval rootcolor "COLOR(0x$c_normbg)"
}

programs() {
	title 'Programs'
	note 'arguments with spaces go in quotes, e.g. foot -e "tmux new"'
	askcmd termcmd 'terminal' "$(defcmd termcmd)"
	askcmd menucmd 'application launcher' "$(defbin menucmd)"
	askcmd traymenucmd 'systray right-click menu' "$(defbin traymenucmd)"
	askcmd filemanagercmd 'file manager' "$(defcmd filemanagercmd)"
	askcmd browsercmd 'browser' "$(defcmd browsercmd)"
}

# dwl runs these through execvp, so each one is stored as its own argument list
# terminated by NULL, and no shell expands anything.
autostart() {
	title 'Autostart'
	note 'started with dwl, one command per line, e.g. swaybg -i ~/wall.png -m fill'
	: >"$tmp/auto"
	while :; do
		ask 'command to autostart (Enter when done)' ''
		[ -n "$ans" ] || break
		set -f; as_ifs=$IFS; IFS='
'
		set -- $(split_cmd "$ans")
		IFS=$as_ifs; set +f
		[ $# -gt 0 ] || continue
		printf '    %sNULL,\n' "$(cargs "$@")" >>"$tmp/auto"
		note "  added: $*"
	done
	if [ -s "$tmp/auto" ]; then
		printf '    NULL // Terminator\n' >>"$tmp/auto"
		auto=$tmp/auto
	fi
}

keybinds() {
	title 'Keybindings'
	menu 'modifier key' \
		"$(case $(awk '/^#define MODKEY/ { print $3 }' "$def") in
		*LOGO) echo 1 ;; *) echo 2 ;; esac)" 'Super (Logo)' 'Alt'
	setval MODKEY "$([ "$choice" = 1 ] && echo WLR_MODIFIER_LOGO || echo WLR_MODIFIER_ALT)"
	note 'xkb key names: q, Return, F1, space'
	for kb_pair in 'termcmd:terminal' 'menucmd:launcher' 'browsercmd:browser' \
		'filemanagercmd:file manager' 'killclient:close window' \
		'togglefloating:toggle floating' 'togglegaps:toggle gaps' \
		'togglebar:toggle bar' 'togglefullscreen:fullscreen (with shift)'; do
		kb_tok=${kb_pair%%:*}
		askkey "MOD + ? for ${kb_pair#*:}" "$(defkey "$kb_tok")"
		setval "bind:$kb_tok" "XKB_KEY_$ans"
	done
}

input() {
	title 'Keyboard and trackpad'
	asknum 'key repeat rate' "$(defval repeat_rate)"; setval repeat_rate "$ans"
	asknum 'key repeat delay in ms' "$(defval repeat_delay)"; setval repeat_delay "$ans"
	ask 'xkb options, e.g. ctrl:nocaps (none to skip)' none
	case $ans in none|'') ;; *) setval xkb_options "\"$ans\"" ;; esac
	askyn 'tap to click' "$(yn "$(defval tap_to_click)")" &&
		setval tap_to_click 1 || setval tap_to_click 0
	askyn 'natural scrolling' "$(yn "$(defval natural_scrolling)")" &&
		setval natural_scrolling 1 || setval natural_scrolling 0
	askyn 'disable the trackpad while typing' "$(yn "$(defval disable_while_typing)")" &&
		setval disable_while_typing 1 || setval disable_while_typing 0
	askyn 'hide the cursor while typing' "$(yn "$(defval hide_cursor_when_typing)")" &&
		setval hide_cursor_when_typing 1 || setval hide_cursor_when_typing 0
}

# wlr-randr talks to the running compositor, the only place the real mode list
# lives; without it the monitors have to be described by hand.
probe_outputs() {
	[ -n "${WAYLAND_DISPLAY:-}" ] || return 1
	command -v wlr-randr >/dev/null 2>&1 || return 1
	wlr-randr >"$tmp/randr" 2>/dev/null || return 1
	awk -v dir="$tmp" '
	/^[^ \t]/ { name = $1; print name > (dir "/outs"); next }
	/px,/ && /Hz/ {
		res = $1; hz = int($3 + 0.5)
		if (seen[name res "@" hz]++) next
		print res, hz, (index($0, "preferred") ? 1 : 0), \
			(index($0, "current") ? 1 : 0) > (dir "/modes." name)
	}' "$tmp/randr"
	[ -s "$tmp/outs" ] || return 1
	# an output with no mode list (disabled, virtual) has nothing to choose from
	while IFS= read -r po; do
		[ -s "$tmp/modes.$po" ] && printf '%s\n' "$po"
	done <"$tmp/outs" >"$tmp/outs.ok"
	mv "$tmp/outs.ok" "$tmp/outs"
	[ -s "$tmp/outs" ]
}

manual_outputs() {
	asknum 'how many monitors' 1
	mo_n=$ans mo_i=1
	: >"$tmp/outs"
	while [ "$mo_i" -le "$mo_n" ]; do
		ask "name of monitor $mo_i, as in wlr-randr" "eDP-$mo_i"
		mo_out=$ans
		printf '%s\n' "$mo_out" >>"$tmp/outs"
		asknum "  width of $mo_out" 1920; mo_w=$ans
		asknum "  height of $mo_out" 1080; mo_h=$ans
		asknum "  refresh of $mo_out in Hz" 60
		printf '%sx%s %s 1 1\n' "$mo_w" "$mo_h" "$ans" >"$tmp/modes.$mo_out"
		mo_i=$((mo_i + 1))
	done
}

# A scale above 1 makes everything bigger, at the cost of a smaller desktop:
# the logical size becomes the resolution divided by the scale.
ask_scale() { # output -> mo_sc
	menu "  scale of $1" 1 'normal (1)' '1.25' '1.5' '2' 'another factor'
	case $choice in
	1) mo_sc=1 ;;
	2) mo_sc=1.25 ;;
	3) mo_sc=1.5 ;;
	4) mo_sc=2 ;;
	*) askfloat "  scale factor of $1" 1; mo_sc=$ans ;;
	esac
}

pick_mode() { # output -> mode_w mode_h mode_hz (0: dwl picks) and log_w log_h
	pm_out=$1 pm_i=1 pm_def=1 pm_best=0
	: >"$tmp/list"
	# the mode in use wins, then the first one the display calls preferred
	while read -r pm_res pm_hz pm_pref pm_cur; do
		pm_tag=
		[ "$pm_pref" = 1 ] && pm_tag=' (preferred)'
		[ "$pm_cur" = 1 ] && pm_tag="$pm_tag (in use)"
		printf '%s %s Hz%s\n' "$pm_res" "$pm_hz" "$pm_tag" >>"$tmp/list"
		if [ "$pm_cur" = 1 ] && [ "$pm_best" -lt 2 ]; then
			pm_def=$pm_i pm_best=2
		elif [ "$pm_pref" = 1 ] && [ "$pm_best" = 0 ]; then
			pm_def=$pm_i pm_best=1
		fi
		pm_i=$((pm_i + 1))
	done <"$tmp/modes.$pm_out"
	set -f; pm_ifs=$IFS; IFS='
'
	set -- $(cat "$tmp/list")
	IFS=$pm_ifs; set +f
	printf '\n%smonitor %s%s\n' "$B" "$pm_out" "$R"
	menu '  mode' "$pm_def" "$@" 'let dwl pick the preferred mode'
	if [ "$choice" -le $# ]; then
		pm_line=$(sed -n "${choice}p" "$tmp/list")
		mode_hz=$(printf '%s' "$pm_line" | awk '{ print $2 }')
	else
		pm_line=$(sed -n "${pm_def}p" "$tmp/list")
		mode_hz=0
	fi
	log_w=${pm_line%%x*}
	log_h=${pm_line#*x} log_h=${log_h%% *}
	if [ "$mode_hz" = 0 ]; then
		mode_w=0 mode_h=0
	else
		mode_w=$log_w mode_h=$log_h
	fi
}

# Everything is placed relative to the primary monitor, then the layout is
# shifted into positive coordinates: Xwayland clients dislike negative origins.
place_monitors() {
	: >"$tmp/mons.pos"
	if [ "$(wc -l <"$tmp/mons.raw")" -le 1 ]; then
		sed 's/$/|-1|-1/' "$tmp/mons.raw" >"$tmp/mons.pos"
		return
	fi
	set -f; pl_ifs=$IFS; IFS='
'
	set -- $(cut -d'|' -f1 "$tmp/mons.raw")
	IFS=$pl_ifs; set +f
	title 'Monitor layout'
	menu 'primary monitor, it sits at the origin' 1 "$@"
	pl_primary=$(cut -d'|' -f1 "$tmp/mons.raw" | sed -n "${choice}p")

	minx=0 miny=0
	maxx=$(awk -F'|' -v n="$pl_primary" '$1 == n { print $9 }' "$tmp/mons.raw")
	maxy=$(awk -F'|' -v n="$pl_primary" '$1 == n { print $10 }' "$tmp/mons.raw")

	while IFS='|' read -r pl_name pl_rest; do
		if [ "$pl_name" = "$pl_primary" ]; then
			pl_x=0 pl_y=0
		else
			pl_lh=${pl_rest##*|}
			pl_lw=${pl_rest%|*} pl_lw=${pl_lw##*|}
			menu "$pl_name sits" 1 "right of $pl_primary" "left of $pl_primary" \
				"above $pl_primary" "below $pl_primary" 'at exact coordinates'
			case $choice in
			1) pl_x=$maxx pl_y=0; maxx=$((maxx + pl_lw)) ;;
			2) pl_x=$((minx - pl_lw)) pl_y=0; minx=$pl_x ;;
			3) pl_x=0 pl_y=$((miny - pl_lh)); miny=$pl_y ;;
			4) pl_x=0 pl_y=$maxy; maxy=$((maxy + pl_lh)) ;;
			*) asknum "  x of $pl_name" 0; pl_x=$ans
			   asknum "  y of $pl_name" 0; pl_y=$ans
			   [ "$pl_x" -lt "$minx" ] && minx=$pl_x
			   [ "$pl_y" -lt "$miny" ] && miny=$pl_y ;;
			esac
		fi
		printf '%s|%s|%s|%s\n' "$pl_name" "$pl_rest" "$pl_x" "$pl_y" >>"$tmp/mons.pos"
	done <"$tmp/mons.raw"

	awk -F'|' -v OFS='|' -v dx="$minx" -v dy="$miny" \
		'{ $11 = $11 - dx; $12 = $12 - dy; print }' "$tmp/mons.pos" >"$tmp/mons.norm"
	mv "$tmp/mons.norm" "$tmp/mons.pos"
}

monitors() {
	title 'Monitors'
	if probe_outputs; then
		note "found with wlr-randr: $(tr '\n' ' ' <"$tmp/outs")"
	else
		note 'wlr-randr unusable here (no running Wayland session?), asking instead'
		manual_outputs
	fi

	: >"$tmp/mons.raw"
	while IFS= read -r mo; do
		pick_mode "$mo"
		mo_rot=WL_OUTPUT_TRANSFORM_NORMAL mo_mf=$(defmfact) mo_nm=1
		ask_scale "$mo"
		if [ "$mode" = advanced ]; then
			menu "  rotation of $mo" 1 normal 90 180 270 flipped
			case $choice in
			2) mo_rot=WL_OUTPUT_TRANSFORM_90 ;;
			3) mo_rot=WL_OUTPUT_TRANSFORM_180 ;;
			4) mo_rot=WL_OUTPUT_TRANSFORM_270 ;;
			5) mo_rot=WL_OUTPUT_TRANSFORM_FLIPPED ;;
			esac
			askfloat "  master area factor of $mo" "$mo_mf"; mo_mf=$ans
			asknum "  windows in the master area of $mo" 1; mo_nm=$ans
		fi
		# monitor positions are logical pixels, so the scale divides them
		log_w=$(awk -v v="$log_w" -v s="$mo_sc" \
			'BEGIN { s += 0; print int(v / (s > 0 ? s : 1)) }')
		log_h=$(awk -v v="$log_h" -v s="$mo_sc" \
			'BEGIN { s += 0; print int(v / (s > 0 ? s : 1)) }')
		printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' "$mo" "$mode_w" "$mode_h" \
			"$mode_hz" "$mo_sc" "$mo_rot" "$mo_mf" "$mo_nm" "$log_w" "$log_h" \
			>>"$tmp/mons.raw"
	done <"$tmp/outs"

	place_monitors
	# designated initializers, so a new MonitorRule field cannot silently
	# shift the meaning of the rows written here
	: >"$mons"
	awk -F'|' '{
		printf "    { .name = \"%s\",\n", $1
		printf "      .mfact = %sf, .nmaster = %s, .scale = %s,\n", $7, $8, $5
		printf "      .lt = &layouts[0], .rr = %s,\n", $6
		printf "      .x = %s, .y = %s, .width = %s, .height = %s, .refresh = %s },\n",
			$11, $12, $2, $3, $4
	}' "$tmp/mons.pos" >>"$mons"
	cat >>"$mons" <<'EOF'
    { .name = NULL, // catch-all for monitors not listed above
      .mfact = 0.55f, .nmaster = 1, .scale = 1,
      .lt = &layouts[0], .rr = WL_OUTPUT_TRANSFORM_NORMAL,
      .x = -1, .y = -1, .width = 0, .height = 0, .refresh = 0 },
EOF
}

generate() { # config.def.h rewritten with the collected values
	awk -v mons="$mons" -v auto="$auto" '
	# keeps the column layout when a replacement is wider or narrower
	function realign(rest, d) {
		while (d > 0 && substr(rest, 2, 1) == " " && substr(rest, 3, 1) == " ") {
			rest = substr(rest, 1, 1) substr(rest, 3); d--
		}
		while (d < 0) { rest = substr(rest, 1, 1) " " substr(rest, 2); d++ }
		return rest
	}
	FNR == NR {
		t = index($0, "\t"); k = substr($0, 1, t - 1); val = substr($0, t + 1)
		if (k ~ /^bind:/) bind[substr(k, 6)] = val; else v[k] = val
		next
	}
	skip { if (index($0, ";")) skip = 0; next }
	drop { if ($0 ~ /^\};/) { print; drop = 0 } next }

	/^#define MODKEY/ && ("MODKEY" in v) { print "#define MODKEY " v["MODKEY"]; next }

	/static const MonitorRule monrules\[\][ \t]*=/ {
		print
		while ((getline l < mons) > 0) print l
		drop = 1; next
	}

	auto != "" && /autostart\[\][ \t]*=/ {
		print
		while ((getline l < auto) > 0) print l
		drop = 1; next
	}

	/^[ \t]*\[Scheme[A-Za-z]*\][ \t]*=/ {
		s = $0; sub(/^[ \t]*\[/, "", s); sub(/\].*/, "", s)
		if (s in v) { printf "%s= %s,\n", substr($0, 1, index($0, "=") - 1), v[s]; next }
	}

	/XKB_KEY_/ {
		for (k in bind) {
			if (!(k in used) && $0 ~ ("[^A-Za-z0-9_]" k "[^A-Za-z0-9_]")) {
				match($0, /XKB_KEY_[A-Za-z0-9_]+/)
				$0 = substr($0, 1, RSTART - 1) bind[k] \
					realign(substr($0, RSTART + RLENGTH), length(bind[k]) - RLENGTH)
				used[k] = 1; break
			}
		}
		print; next
	}

	/^[ \t]*\.options[ \t]*=/ && ("xkb_options" in v) {
		printf "%s= %s,\n", substr($0, 1, index($0, "=") - 1), v["xkb_options"]; next
	}

	/^static/ && index($0, "=") {
		eq = index($0, "="); lhs = substr($0, 1, eq - 1); name = lhs
		sub(/[ \t]*(\[\])?[ \t]*$/, "", name); sub(/^.*[^A-Za-z0-9_]/, "", name)
		if (name in v) {
			rest = substr($0, eq + 1); sc = index(rest, ";"); tail = ""
			if (sc) {
				old = substr(rest, 1, sc - 1); sub(/^[ \t]+/, "", old)
				tail = realign(";" substr(rest, sc + 1),
					length(v[name]) - length(old))
			} else { tail = ";"; skip = 1 }
			printf "%s= %s%s\n", lhs, v[name], tail; next
		}
	}
	{ print }
	' "$vals" "$def"
}

main() {
	srcdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
	def=$srcdir/config.def.h
	out=$srcdir/config.h
	mode=normal
	edit=

	options "$@"
	workspace
	interface
	theme_defaults

	printf '%sdwl config generator%s\n' "$B" "$R"

	keep=
	if [ -f "$out" ] && [ -z "$edit" ]; then
		title 'A config.h is already there'
		menu 'what should happen to it' 4 'cancel' 'keep a backup, then generate' \
			'overwrite it' 'edit it: its own settings become the defaults'
		case $choice in
		1) note 'nothing written'; exit 0 ;;
		2) keep=$out.$(date +%Y%m%d-%H%M%S).bak ;;
		4) def=$out keep=$out.$(date +%Y%m%d-%H%M%S).bak ;;
		esac
	elif [ -n "$edit" ]; then
		keep=$out.$(date +%Y%m%d-%H%M%S).bak
	fi
	note "defaults from ${def##*/}, writing ${out##*/}"

	title 'Mode'
	menu 'how much do you want to configure' 1 \
		'normal: programs and monitors, the rest stays default' \
		'advanced: every main setting'
	[ "$choice" = 2 ] && mode=advanced

	if [ "$mode" = advanced ]; then
		appearance
		opacity
		bar
		fontsel
		colors
		programs
		autostart
		keybinds
		input
	else
		opacity
		programs
		autostart
	fi
	monitors

	generate >"$tmp/config.h"
	grep -q 'static const Key keys' "$tmp/config.h" || die 'generated file looks wrong, nothing written'
	if [ -n "$keep" ]; then
		cp "$out" "$keep" || die "cannot back up $out"
	fi
	cp "$tmp/config.h" "$out" || die "cannot write $out"

	title 'Done'
	[ -n "$keep" ] && note "previous config kept as ${keep##*/}"
	printf 'wrote %s\n' "$out"
	note "check it over, then run './configure && make'"
}

main "$@"
